{
  "name": "genoma-lab",
  "productName": "Genoma Lab",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz visual y didáctica del mini sistema de análisis genómico basado en k-mers (el motor es el programa en C++).",
  "author": "Proyecto Genómico — EDA 2, Universidad de Lima",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "mocks": "node scripts/generar-mocks.mjs",
    "comparar-motor": "node scripts/comparar-con-motor.mjs",
    "preparar-motor": "node scripts/preparar-motor.mjs",
    "empaquetar": "npm run preparar-motor && electron-vite build && electron-builder --win",
    "empaquetar:carpeta": "npm run preparar-motor && electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "d3": "^7.9.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
